<UserControl
    x:Class="WinIsland.App.Views.ShelfView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinIsland.App"
    xmlns:modules="using:WinIsland.Core.Modules">

    <!-- Drop files here to park them; drag them out wherever you need them. -->
    <Grid Padding="16,14,16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon FontSize="15" Foreground="#FFBF5AF2" Glyph="&#xE7B8;" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontFamily="Segoe UI Variable Display"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{StaticResource IslandForegroundBrush}"
                Text="Shelf" />
            <Button
                Grid.Column="2"
                Command="{x:Bind Module.ClearCommand}"
                Content="Clear"
                Style="{StaticResource IslandTextChipButton}"
                Visibility="{x:Bind Module.HasItems, Mode=OneWay}" />
        </Grid>

        <Border
            Grid.Row="1"
            BorderBrush="#4DBF5AF2"
            BorderThickness="1.5"
            CornerRadius="16"
            Visibility="{x:Bind Module.IsEmpty, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                <FontIcon FontSize="18" Foreground="#FFBF5AF2" Glyph="&#xE896;" />
                <TextBlock Style="{StaticResource IslandBodyStyle}" Text="Drop files here" />
            </StackPanel>
        </Border>

        <ListView
            x:Name="ShelfList"
            Grid.Row="1"
            Margin="-4,0"
            CanDragItems="True"
            DragItemsStarting="OnDragItemsStarting"
            ItemsSource="{x:Bind Module.Items}"
            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.VerticalScrollMode="Disabled"
            SelectionMode="None"
            Visibility="{x:Bind Module.HasItems, Mode=OneWay}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="4,0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="CornerRadius" Value="14" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="modules:ShelfItem">
                    <Grid
                        Width="84"
                        Height="88"
                        Padding="6,8"
                        Background="{StaticResource IslandRaisedBrush}"
                        CornerRadius="14"
                        DoubleTapped="OnItemDoubleTapped"
                        RowSpacing="6"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="{x:Bind Path}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <FontIcon FontSize="24" Foreground="{StaticResource IslandForegroundBrush}" Glyph="{x:Bind Glyph}" />
                        <TextBlock
                            Grid.Row="1"
                            FontSize="11"
                            Foreground="{StaticResource IslandSecondaryBrush}"
                            MaxLines="2"
                            Text="{x:Bind Name}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <Button
                            Width="20"
                            Height="20"
                            Margin="0,-4,-2,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Remove"
                            Click="OnRemoveClick"
                            CornerRadius="10"
                            Padding="0"
                            Style="{StaticResource IslandRoundButton}"
                            Tag="{x:Bind}">
                            <FontIcon FontSize="8" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
