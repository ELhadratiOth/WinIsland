<UserControl
    x:Class="WinIsland.App.Views.CiView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinIsland.App"
    xmlns:modules="using:WinIsland.Core.Modules">

    <!-- Latest GitHub Actions run of each workflow; click one to open it. -->
    <Grid Padding="16,14,16,10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon FontSize="15" Foreground="{StaticResource IslandForegroundBrush}" Glyph="&#xE943;" />
            <TextBlock
                FontFamily="Segoe UI Variable Display"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{StaticResource IslandForegroundBrush}"
                Text="Builds" />
        </StackPanel>
        <TextBlock
            Grid.Row="1"
            FontFamily="Segoe UI Variable Display"
            FontSize="17"
            FontWeight="SemiBold"
            Foreground="{x:Bind local:Converters.ToBrush(Module.AccentArgb), Mode=OneWay}"
            Text="{x:Bind Module.Headline, Mode=OneWay}"
            Visibility="{x:Bind Module.HasHeadline, Mode=OneWay}" />
        <ListView
            Grid.Row="2"
            Margin="-6,0"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemContainerStyle="{StaticResource SessionItemStyle}"
            ItemsSource="{x:Bind Module.Runs}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="modules:RunItem">
                    <Grid Height="44" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="26"
                            Height="26"
                            Background="{x:Bind local:Converters.ToSoftBrush(StatusArgb)}"
                            CornerRadius="13">
                            <FontIcon FontSize="11" Foreground="{x:Bind local:Converters.ToBrush(StatusArgb)}" Glyph="{x:Bind StatusGlyph}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                Foreground="{StaticResource IslandForegroundBrush}"
                                MaxLines="1"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource IslandTertiaryBrush}"
                                MaxLines="1"
                                Text="{x:Bind Detail}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
