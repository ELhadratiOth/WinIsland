<UserControl
    x:Class="WinIsland.App.Views.ApprovalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinIsland.App">

    <Grid>
        <!-- A Claude Code permission prompt: what it wants to do, and Allow / Deny / Ask in terminal. -->
        <Grid
            Padding="18,14,18,14"
            RowSpacing="10"
            Visibility="{x:Bind Module.HasRequest, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                    <Path Data="M12,2 L12,22 M2,12 L22,12 M4.9,4.9 L19.1,19.1 M19.1,4.9 L4.9,19.1" Style="{StaticResource ClaudeGlyphStyle}" />
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource IslandForegroundBrush}"
                        Text="{x:Bind Module.Title, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource IslandCaptionStyle}"
                        Text="{x:Bind Module.Project, Mode=OneWay}" />
                </StackPanel>
                <Border
                    Grid.Column="2"
                    Padding="9,2,9,3"
                    VerticalAlignment="Center"
                    Background="{StaticResource IslandClaudeSoftBrush}"
                    CornerRadius="10">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource IslandClaudeBrush}"
                        Text="{x:Bind Module.ToolLabel, Mode=OneWay}" />
                </Border>
            </Grid>

            <Border
                Grid.Row="1"
                Padding="12,9"
                Background="{StaticResource IslandRaisedBrush}"
                CornerRadius="12">
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12.5"
                    Foreground="{StaticResource IslandForegroundBrush}"
                    IsTextSelectionEnabled="True"
                    MaxLines="3"
                    Text="{x:Bind Module.Summary, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource IslandCaptionStyle}"
                    Text="{x:Bind Module.MoreText, Mode=OneWay}" />
                <Button
                    Grid.Column="1"
                    Command="{x:Bind Module.AskCommand}"
                    Content="In terminal"
                    Style="{StaticResource IslandTileButton}"
                    ToolTipService.ToolTip="Answer this in Claude Code instead" />
                <Button
                    Grid.Column="2"
                    Background="#33FF453A"
                    Command="{x:Bind Module.DenyCommand}"
                    Content="Deny"
                    Foreground="#FFFF6961"
                    Style="{StaticResource IslandTileButton}" />
                <Button
                    Grid.Column="3"
                    MinWidth="84"
                    Background="{StaticResource IslandClaudeBrush}"
                    Command="{x:Bind Module.AllowCommand}"
                    Content="Allow"
                    Foreground="#FF1A0F0B"
                    Style="{StaticResource IslandTileButton}" />
            </Grid>
        </Grid>

        <!-- "Claude is waiting for your input" -->
        <Grid
            Padding="18,0,22,0"
            ColumnSpacing="14"
            Visibility="{x:Bind Module.HasNoticeOnly, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="44"
                Height="44"
                VerticalAlignment="Center"
                Background="{StaticResource IslandClaudeSoftBrush}"
                CornerRadius="22">
                <Viewbox Width="22" Height="22">
                    <Path Data="M12,2 L12,22 M2,12 L22,12 M4.9,4.9 L19.1,19.1 M19.1,4.9 L4.9,19.1" Style="{StaticResource ClaudeGlyphStyle}" />
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource IslandCaptionStyle}" Text="{x:Bind local:Converters.Upper(Module.Project), Mode=OneWay}" />
                <TextBlock
                    FontFamily="Segoe UI Variable Display"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource IslandForegroundBrush}"
                    MaxLines="1"
                    Text="{x:Bind Module.Summary, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
