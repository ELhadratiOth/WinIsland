<UserControl
    x:Class="WinIsland.App.Views.OsdView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinIsland.App">

    <!-- Slim on-screen display for volume / brightness / mic / battery changes. -->
    <Grid Padding="14,0,16,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon
            VerticalAlignment="Center"
            FontSize="15"
            Foreground="{x:Bind local:Converters.ToBrush(Module.AccentArgb), Mode=OneWay}"
            Glyph="{x:Bind Module.OsdGlyph, Mode=OneWay}" />
        <Grid
            Grid.Column="1"
            Height="5"
            VerticalAlignment="Center"
            Background="{StaticResource IslandTrackBrush}"
            CornerRadius="2.5"
            Visibility="{x:Bind Module.OsdShowsBar, Mode=OneWay}">
            <Rectangle
                x:Name="OsdFill"
                HorizontalAlignment="Stretch"
                Fill="{x:Bind local:Converters.ToBrush(Module.AccentArgb), Mode=OneWay}"
                RadiusX="2.5"
                RadiusY="2.5">
                <Rectangle.RenderTransform>
                    <ScaleTransform ScaleX="{x:Bind Module.OsdFraction, Mode=OneWay}" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            Style="{StaticResource IslandCompactTextStyle}"
            Text="{x:Bind Module.OsdLabel, Mode=OneWay}"
            Visibility="{x:Bind local:Converters.CollapsedWhen(Module.OsdShowsBar), Mode=OneWay}" />
        <TextBlock
            Grid.Column="2"
            MinWidth="26"
            VerticalAlignment="Center"
            FontFamily="Segoe UI Variable Display"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{StaticResource IslandSecondaryBrush}"
            Text="{x:Bind Module.OsdText, Mode=OneWay}"
            TextAlignment="Right"
            Typography.NumeralAlignment="Tabular" />
    </Grid>
</UserControl>
