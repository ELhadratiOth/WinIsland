<UserControl
    x:Class="WinIsland.App.Views.TimerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinIsland.App">

    <!-- Timer · stopwatch · Pomodoro: ring with the time on the left, modes and controls on the right. -->
    <Grid Padding="18,14,18,12" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Width="104" Height="104" VerticalAlignment="Center">
            <ProgressRing
                Width="104"
                Height="104"
                Background="{StaticResource IslandTrackBrush}"
                Foreground="{x:Bind local:Converters.ToBrush(Module.AccentArgb), Mode=OneWay}"
                IsIndeterminate="False"
                Maximum="100"
                Value="{x:Bind Module.Progress, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe UI Variable Display"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource IslandForegroundBrush}"
                Text="{x:Bind Module.DisplayText, Mode=OneWay}"
                Typography.NumeralAlignment="Tabular" />
        </Grid>

        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button
                    Background="{x:Bind local:Converters.ChipBackground(Module.IsTimerMode), Mode=OneWay}"
                    Command="{x:Bind Module.SetModeCommand}"
                    CommandParameter="Timer"
                    Content="Timer"
                    Foreground="{x:Bind local:Converters.ChipForeground(Module.IsTimerMode), Mode=OneWay}"
                    Style="{StaticResource IslandTextChipButton}" />
                <Button
                    Background="{x:Bind local:Converters.ChipBackground(Module.IsStopwatchMode), Mode=OneWay}"
                    Command="{x:Bind Module.SetModeCommand}"
                    CommandParameter="Stopwatch"
                    Content="Stopwatch"
                    Foreground="{x:Bind local:Converters.ChipForeground(Module.IsStopwatchMode), Mode=OneWay}"
                    Style="{StaticResource IslandTextChipButton}" />
                <Button
                    Background="{x:Bind local:Converters.ChipBackground(Module.IsPomodoroMode), Mode=OneWay}"
                    Command="{x:Bind Module.SetModeCommand}"
                    CommandParameter="Pomodoro"
                    Content="Pomodoro"
                    Foreground="{x:Bind local:Converters.ChipForeground(Module.IsPomodoroMode), Mode=OneWay}"
                    Style="{StaticResource IslandTextChipButton}" />
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Style="{StaticResource IslandCaptionStyle}"
                Text="{x:Bind Module.Caption, Mode=OneWay}" />

            <StackPanel
                Grid.Row="2"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="{x:Bind Module.ShowPresets, Mode=OneWay}">
                <Button Command="{x:Bind Module.PresetCommand}" CommandParameter="1" Content="1m" Style="{StaticResource IslandTextChipButton}" />
                <Button Command="{x:Bind Module.PresetCommand}" CommandParameter="5" Content="5m" Style="{StaticResource IslandTextChipButton}" />
                <Button Command="{x:Bind Module.PresetCommand}" CommandParameter="10" Content="10m" Style="{StaticResource IslandTextChipButton}" />
                <Button Command="{x:Bind Module.PresetCommand}" CommandParameter="15" Content="15m" Style="{StaticResource IslandTextChipButton}" />
                <Button Command="{x:Bind Module.PresetCommand}" CommandParameter="30" Content="30m" Style="{StaticResource IslandTextChipButton}" />
            </StackPanel>

            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    AutomationProperties.Name="{x:Bind Module.StartPauseLabel, Mode=OneWay}"
                    Background="{x:Bind local:Converters.ToBrush(Module.AccentArgb), Mode=OneWay}"
                    Command="{x:Bind Module.StartPauseCommand}"
                    Foreground="#FF1A0F05"
                    Style="{StaticResource IslandTileButton}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="12" Glyph="{x:Bind Module.StartPauseGlyph, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Module.StartPauseLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="Reset"
                    Command="{x:Bind Module.ResetCommand}"
                    Style="{StaticResource IslandRoundButton}">
                    <FontIcon FontSize="13" Glyph="&#xE777;" />
                </Button>
                <Button
                    AutomationProperties.Name="Add a minute"
                    Command="{x:Bind Module.AddMinuteCommand}"
                    Content="+1m"
                    Style="{StaticResource IslandTileButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
