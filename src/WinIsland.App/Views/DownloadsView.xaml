<UserControl
    x:Class="WinIsland.App.Views.DownloadsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:modules="using:WinIsland.Core.Modules">

    <!-- Downloads in progress (size · speed) and the last few finished ones. -->
    <Grid Padding="16,14,16,10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon FontSize="15" Foreground="#FF0A84FF" Glyph="&#xE896;" />
            <TextBlock
                FontFamily="Segoe UI Variable Display"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{StaticResource IslandForegroundBrush}"
                Text="Downloads" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="4">
                <ItemsControl ItemsSource="{x:Bind Module.Active}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="modules:DownloadItem">
                            <Grid Height="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" Background="#260A84FF" CornerRadius="9">
                                    <FontIcon FontSize="13" Foreground="#FF0A84FF" Glyph="{x:Bind Glyph}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <Grid>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource IslandForegroundBrush}"
                                            MaxLines="1"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="11"
                                            Foreground="{StaticResource IslandSecondaryBrush}"
                                            Text="{x:Bind Detail}" />
                                    </Grid>
                                    <ProgressBar Foreground="#FF0A84FF" IsIndeterminate="True" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{x:Bind Module.Recent}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="modules:CompletedItem">
                            <Grid Height="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" Background="{StaticResource IslandRaisedBrush}" CornerRadius="9">
                                    <FontIcon FontSize="13" Foreground="{StaticResource IslandForegroundBrush}" Glyph="{x:Bind Glyph}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{StaticResource IslandForegroundBrush}"
                                        MaxLines="1"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource IslandTertiaryBrush}" Text="{x:Bind Detail}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Button
                                        Click="OnOpenClick"
                                        Content="Open"
                                        Style="{StaticResource IslandTextChipButton}"
                                        Tag="{x:Bind}" />
                                    <Button
                                        AutomationProperties.Name="Show in folder"
                                        Click="OnRevealClick"
                                        Style="{StaticResource IslandTextChipButton}"
                                        Tag="{x:Bind}">
                                        <FontIcon FontSize="11" Glyph="&#xE838;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
