<UserControl
    x:Class="WinIsland.App.Views.CalendarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinIsland.App"
    xmlns:modules="using:WinIsland.Core.Modules">

    <!-- Next meeting with a Join button, then the rest of today. -->
    <Grid Padding="18,14,18,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" Background="#26FF453A" CornerRadius="12">
                <FontIcon FontSize="17" Foreground="#FFFF453A" Glyph="&#xE787;" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    FontFamily="Segoe UI Variable Display"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource IslandForegroundBrush}"
                    MaxLines="1"
                    Text="{x:Bind Module.NextTitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FFFF453A" Text="{x:Bind Module.NextWhen, Mode=OneWay}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource IslandSecondaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind Module.NextLocation, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <Button
                Grid.Column="2"
                Background="#FF30D158"
                Command="{x:Bind Module.JoinCommand}"
                Foreground="#FF04210D"
                Style="{StaticResource IslandTileButton}"
                Visibility="{x:Bind Module.HasJoin, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontSize="12" Glyph="&#xE714;" />
                    <TextBlock Text="{x:Bind Module.JoinLabel, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Module.Today}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="modules:AgendaItem">
                    <Grid Height="30" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle
                            Height="18"
                            Fill="{x:Bind local:Converters.AgendaBar(IsNext)}"
                            RadiusX="2"
                            RadiusY="2" />
                        <TextBlock
                            Grid.Column="1"
                            MinWidth="96"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource IslandSecondaryBrush}"
                            Text="{x:Bind When}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{StaticResource IslandForegroundBrush}"
                            MaxLines="1"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
