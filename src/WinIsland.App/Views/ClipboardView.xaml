<UserControl
    x:Class="WinIsland.App.Views.ClipboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:modules="using:WinIsland.Core.Modules">

    <!-- Recent copies; click one to paste it into the app you were using. -->
    <Grid Padding="16,14,16,10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon FontSize="15" Foreground="#FF0A84FF" Glyph="&#xE77F;" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    FontFamily="Segoe UI Variable Display"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource IslandForegroundBrush}"
                    Text="Clipboard" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource IslandCaptionStyle}"
                    Text="CLICK TO PASTE" />
            </StackPanel>
            <Button
                Grid.Column="2"
                Command="{x:Bind Module.ClearCommand}"
                Content="Clear"
                Style="{StaticResource IslandTextChipButton}" />
        </Grid>
        <ListView
            x:Name="ItemsList"
            Grid.Row="1"
            Margin="-6,0"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemContainerStyle="{StaticResource SessionItemStyle}"
            ItemsSource="{x:Bind Module.Items}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="modules:ClipboardItem">
                    <Grid Height="40" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            Background="{StaticResource IslandRaisedBrush}"
                            CornerRadius="8">
                            <FontIcon FontSize="12" Foreground="{StaticResource IslandSecondaryBrush}" Glyph="{x:Bind Glyph}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                Foreground="{StaticResource IslandForegroundBrush}"
                                MaxLines="1"
                                Text="{x:Bind Preview}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource IslandTertiaryBrush}"
                                Text="{x:Bind Detail, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="Remove"
                            Click="OnRemoveClick"
                            Style="{StaticResource IslandTransportButton}"
                            Tag="{x:Bind}"
                            Width="28"
                            Height="28">
                            <FontIcon FontSize="10" Foreground="{StaticResource IslandTertiaryBrush}" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
