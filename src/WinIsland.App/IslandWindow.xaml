<Window
    x:Class="WinIsland.App.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:modules="using:WinIsland.Core.Modules"
    Title="WinIsland">

    <!-- Transparent root: only the clipped PillSurface is visible. -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <!-- Escape always ends interaction and hands focus back. -->
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid x:Name="PillSurface" Background="{StaticResource IslandBackgroundBrush}">
            <Grid
                x:Name="ContentHost"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Compact: glyph + short label (+ activity dot) -->
                <Grid
                    x:Name="CompactLayer"
                    Padding="14,0"
                    ColumnSpacing="8"
                    Visibility="{x:Bind ViewModel.IsCompact, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource IslandSecondaryBrush}"
                        Glyph="{x:Bind ViewModel.CompactGlyph, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource IslandForegroundBrush}"
                        MaxLines="1"
                        Text="{x:Bind ViewModel.CompactText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <Ellipse
                        Grid.Column="2"
                        Width="7"
                        Height="7"
                        VerticalAlignment="Center"
                        Fill="{StaticResource IslandActivityBrush}"
                        Visibility="{x:Bind ViewModel.ShowActivityDot, Mode=OneWay}" />
                </Grid>

                <!-- Expanded: clock -->
                <StackPanel
                    x:Name="ClockLayer"
                    Padding="24,0"
                    VerticalAlignment="Center"
                    Spacing="2"
                    Visibility="{x:Bind ViewModel.ShowClockExpanded, Mode=OneWay}">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource IslandForegroundBrush}"
                        Text="{x:Bind ViewModel.Clock.TimeText, Mode=OneWay}" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{StaticResource IslandSecondaryBrush}"
                        Text="{x:Bind ViewModel.Clock.DateText, Mode=OneWay}" />
                </StackPanel>

                <!-- Expanded: media -->
                <Grid
                    x:Name="MediaLayer"
                    Padding="18,12"
                    ColumnSpacing="12"
                    RowSpacing="6"
                    Visibility="{x:Bind ViewModel.ShowMediaExpanded, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center"
                        Background="{StaticResource IslandSubtleFillBrush}"
                        CornerRadius="10">
                        <FontIcon FontSize="18" Foreground="{StaticResource IslandAccentBrush}" Glyph="&#xEC4F;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource IslandForegroundBrush}"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.Media.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource IslandSecondaryBrush}"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.Media.Artist, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            AutomationProperties.Name="Previous"
                            Command="{x:Bind ViewModel.Media.PreviousCommand}"
                            Style="{StaticResource IslandIconButton}">
                            <FontIcon FontSize="14" Glyph="&#xE892;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Play or pause"
                            Command="{x:Bind ViewModel.Media.TogglePlayPauseCommand}"
                            Style="{StaticResource IslandIconButton}">
                            <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.Media.PlayPauseGlyph, Mode=OneWay}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Next"
                            Command="{x:Bind ViewModel.Media.NextCommand}"
                            Style="{StaticResource IslandIconButton}">
                            <FontIcon FontSize="14" Glyph="&#xE893;" />
                        </Button>
                    </StackPanel>
                    <Grid
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="10"
                            Foreground="{StaticResource IslandSecondaryBrush}"
                            Text="{x:Bind ViewModel.Media.PositionText, Mode=OneWay}" />
                        <ProgressBar
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource IslandForegroundBrush}"
                            Maximum="100"
                            Value="{x:Bind ViewModel.Media.Progress, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="2"
                            FontSize="10"
                            Foreground="{StaticResource IslandSecondaryBrush}"
                            Text="{x:Bind ViewModel.Media.DurationText, Mode=OneWay}" />
                    </Grid>
                </Grid>

                <!-- Expanded: Claude Code notification -->
                <Grid
                    x:Name="ClaudeNoticeLayer"
                    Padding="20,0"
                    ColumnSpacing="12"
                    Visibility="{x:Bind ViewModel.ShowClaudeExpanded, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{StaticResource IslandActivityBrush}"
                        Glyph="&#xE99A;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource IslandForegroundBrush}"
                            Text="Claude Code" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource IslandSecondaryBrush}"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.Claude.AttentionText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Large: Claude Code panel -->
                <Grid
                    x:Name="ClaudePanelLayer"
                    Padding="18,14,18,14"
                    RowSpacing="10"
                    Visibility="{x:Bind ViewModel.ShowClaudeLarge, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource IslandForegroundBrush}"
                        Text="Claude Code" />
                    <ListView
                        x:Name="SessionList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Claude.Sessions}"
                        SelectedItem="{x:Bind ViewModel.Claude.SelectedSession, Mode=OneWay}"
                        SelectionChanged="OnSessionSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="modules:ClaudeSessionItem">
                                <Grid Height="28" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource IslandAccentBrush}"
                                        Text="{x:Bind StatusGlyph, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource IslandForegroundBrush}"
                                        MaxLines="1"
                                        Text="{x:Bind ProjectName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource IslandSecondaryBrush}"
                                        Text="{x:Bind StatusText, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="MessageInput"
                            GotFocus="OnTextInputGotFocus"
                            KeyDown="OnMessageInputKeyDown"
                            LostFocus="OnTextInputLostFocus"
                            PlaceholderText="Send message…"
                            Text="{x:Bind ViewModel.Claude.DraftMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.Claude.SendCommand}"
                            Content="Send" />
                    </Grid>
                    <TextBlock
                        Grid.Row="3"
                        FontSize="11"
                        Foreground="{StaticResource IslandSecondaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind ViewModel.Claude.StatusMessage, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Module switcher strip (interactive only; its height is included in the island size) -->
                <ItemsControl
                    x:Name="Switcher"
                    Grid.Row="1"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.SwitcherModules, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowSwitcher, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="modules:IslandModule">
                            <Button
                                Width="26"
                                Height="26"
                                AutomationProperties.Name="{x:Bind DisplayName}"
                                Click="OnModuleButtonClick"
                                Style="{StaticResource IslandIconButton}"
                                Tag="{x:Bind Id}"
                                ToolTipService.ToolTip="{x:Bind DisplayName}">
                                <FontIcon FontSize="12" Glyph="{x:Bind Glyph}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
