<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WinUI 3 shell. Unpackaged and Windows App SDK self-contained, so it runs as a plain .exe
    that can be registered under HKCU\...\Run without an installer. Build on Windows:
      dotnet build src/WinIsland.App -c Release -p:Platform=x64
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>WinIsland.App</RootNamespace>
    <AssemblyName>WinIsland</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinIsland.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Background-utility footprint: no background GC thread, fast startup when published. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\WinIsland.ico" />
    <Content Include="Assets\PreviewArt.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="WinUIEx" />
  </ItemGroup>

  <!--
    `dotnet publish` of an unpackaged WinUI app omits the app's own resource index (WinIsland.pri)
    and compiled XAML (*.xbf), so InitializeComponent fails with "XAML parsing failed" in the
    published app while the build output works. Copy them from the build output after publishing.
  -->
  <Target Name="PublishXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <_XamlResourceToPublish Include="$(OutDir)$(AssemblyName).pri" />
      <_XamlResourceToPublish Include="$(OutDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlResourceToPublish)"
          DestinationFiles="@(_XamlResourceToPublish->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Published XAML resources: @(_XamlResourceToPublish->'%(Filename)%(Extension)', ', ')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\WinIsland.Core\WinIsland.Core.csproj" />
    <ProjectReference Include="..\WinIsland.Platform.Windows\WinIsland.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
