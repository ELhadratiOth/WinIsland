<Window
    x:Class="WinIsland.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:WinIsland.App.Services"
    Title="WinIsland settings">

    <Grid x:Name="SettingsRoot">
        <Grid.Resources>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="4,20,0,6" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,4" />
            </Style>
            <Style x:Key="RowStyle" TargetType="Grid">
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="ColumnSpacing" Value="16" />
            </Style>
            <Style x:Key="RowDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <ScrollViewer>
            <StackPanel MaxWidth="760" Padding="32,24,32,40">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource RowDescriptionStyle}"
                    Text="Changes apply immediately." />

                <!-- ===== General ===== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="General" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="When to hide the island" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="Games and fullscreen video stay uncovered." />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="260"
                                VerticalAlignment="Center"
                                SelectedIndex="{x:Bind ViewModel.VisibilityIndex, Mode=TwoWay}">
                                <x:String>Always show (including games)</x:String>
                                <x:String>Hide in games</x:String>
                                <x:String>Hide in fullscreen apps</x:String>
                                <x:String>Hide when an app is maximized</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Display" />
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="260"
                                VerticalAlignment="Center"
                                SelectedIndex="{x:Bind ViewModel.DisplayIndex, Mode=TwoWay}">
                                <x:String>Primary display</x:String>
                                <x:String>Follow the active window</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Expand on hover" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="Rest the pointer on the island to use it. Win+Alt+I always works." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.HoverToInteract, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Focus mode" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="Only the clock, timers, meetings, microphone/camera and Claude approvals appear." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.FocusMode, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Start with Windows" />
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Modules ===== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Island modules" />
                <Border Style="{StaticResource CardStyle}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Modules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:ModuleToggle">
                                <Grid MinHeight="48" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="{x:Bind Glyph}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Name}" />
                                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ===== Music ===== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Music" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Find missing cover art online" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="Asks Apple's iTunes Search with the artist and title only." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.OnlineArtwork, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Lyrics" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="Time-synced lyrics from lrclib.net (sends artist, title, album and length)." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.OnlineLyrics, Mode=TwoWay}" />
                        </Grid>
                        <StackPanel Padding="0,12,0,14" Spacing="8">
                            <TextBlock Text="Spotify Liked Songs" />
                            <TextBlock Style="{StaticResource RowDescriptionStyle}">
                                <Run Text="Create a free app at developer.spotify.com/dashboard, add the redirect URI " /><Run FontWeight="SemiBold" Text="http://127.0.0.1:43821/callback" /><Run Text=", tick Web API, then paste its Client ID here and connect. WinIsland talks to Spotify directly; no secret is needed." />
                            </TextBlock>
                            <HyperlinkButton Padding="0" Content="Open the Spotify developer dashboard" NavigateUri="https://developer.spotify.com/dashboard" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="Client ID" Text="{x:Bind ViewModel.SpotifyClientId, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.ConnectSpotifyCommand}"
                                    Content="Connect"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind ViewModel.IsSpotifyDisconnected, Mode=OneWay}" />
                                <Button
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.DisconnectSpotifyCommand}"
                                    Content="Disconnect"
                                    Visibility="{x:Bind ViewModel.IsSpotifyConnected, Mode=OneWay}" />
                            </Grid>
                            <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="{x:Bind ViewModel.SpotifyStatus, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Weather & calendar ===== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Weather and calendar" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Weather next to the clock" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="From Open-Meteo (free, no account). Leave the city empty to use your Windows location if you allow it." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowWeather, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                VerticalAlignment="Center"
                                PlaceholderText="City (e.g. Casablanca)"
                                Text="{x:Bind ViewModel.WeatherLocation, Mode=TwoWay}" />
                            <ToggleSwitch
                                Grid.Column="1"
                                IsOn="{x:Bind ViewModel.WeatherFahrenheit, Mode=TwoWay}"
                                OffContent="°C"
                                OnContent="°F" />
                        </Grid>
                        <StackPanel Padding="0,12,0,14" Spacing="8">
                            <TextBlock Text="Calendar feeds" />
                            <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="Paste your calendar's private ICS link, one per line. Google Calendar: Settings › your calendar › Secret address in iCal format. Outlook: Settings › Calendar › Shared calendars › Publish a calendar › ICS. The island shows your next meeting 10 minutes before, reminds you at 5 and offers Join for Teams, Zoom, Meet and Webex links. Links are stored encrypted." />
                            <TextBox
                                MinHeight="72"
                                AcceptsReturn="True"
                                PlaceholderText="https://calendar.google.com/calendar/ical/…/basic.ics"
                                Text="{x:Bind ViewModel.CalendarFeeds, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Claude Code ===== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Claude Code" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Padding="0,12,0,14" Spacing="8">
                        <TextBlock Text="Approve Claude Code from the island" />
                        <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="Adds a PermissionRequest hook to ~/.claude/settings.json (your other settings are kept, and a backup is made). Permission prompts then appear on the island with Allow, Deny or In terminal. If WinIsland isn't running, Claude Code asks in the terminal as usual. It also sets WinIsland as Claude Code's status line (unless you already have your own), which is how your plan limits (Pro/Max, the same numbers as /usage) reach the island." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Command="{x:Bind ViewModel.ConnectClaudeCommand}"
                                Content="Connect"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.IsClaudeDisconnected, Mode=OneWay}" />
                            <Button
                                Command="{x:Bind ViewModel.DisconnectClaudeCommand}"
                                Content="Disconnect"
                                Visibility="{x:Bind ViewModel.IsClaudeConnected, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="{x:Bind ViewModel.ClaudeStatus, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- ===== GitHub ===== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="GitHub Actions" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Padding="0,12,0,14" Spacing="8">
                        <TextBlock Text="Repositories" />
                        <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="One per line, like owner/name. Builds that start and finish appear on the island." />
                        <TextBox
                            MinHeight="72"
                            AcceptsReturn="True"
                            PlaceholderText="ELhadratiOth/WinIsland"
                            Text="{x:Bind ViewModel.GitHubRepos, Mode=TwoWay}"
                            TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0" Text="Access token (for private repositories)" />
                        <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="A fine-grained token with read-only Actions access. Stored encrypted for your Windows account; GITHUB_TOKEN or GH_TOKEN also work." />
                        <PasswordBox Password="{x:Bind ViewModel.GitHubToken, Mode=TwoWay}" PlaceholderText="github_pat_…" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
