<Application
    x:Class="WinIsland.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The island is always dark, like a hardware notch, regardless of the app theme. -->
            <SolidColorBrush x:Key="IslandBackgroundBrush" Color="#FF050505" />
            <SolidColorBrush x:Key="IslandForegroundBrush" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="IslandSecondaryBrush" Color="#FF98989F" />
            <SolidColorBrush x:Key="IslandAccentBrush" Color="#FF34C759" />
            <SolidColorBrush x:Key="IslandActivityBrush" Color="#FFFF9F0A" />
            <SolidColorBrush x:Key="IslandSubtleFillBrush" Color="#FF1C1C1E" />

            <Style x:Key="IslandIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource IslandForegroundBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
