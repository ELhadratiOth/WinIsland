<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Thin Windows integration layer: Win32 window management, WinEvent hooks, monitors/DPI,
    the hover hook thread, tray icon, and WinRT media/connectivity. No WinUI dependency, so it
    compiles on any OS with EnableWindowsTargeting (see Directory.Build.props).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>WinIsland.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- WMI: built-in display brightness (no WinRT API exists for unpackaged apps). -->
    <PackageReference Include="System.Management" />
    <!-- DPAPI: keeps sign-in tokens (Spotify, GitHub) encrypted for the current Windows user. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinIsland.Core\WinIsland.Core.csproj" />
  </ItemGroup>
</Project>
